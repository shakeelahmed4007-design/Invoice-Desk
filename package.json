{
  "name": "invoice-approval-desk",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,UI -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w server",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "node scripts/e2e.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "1.51.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.26.0"
  }
}
